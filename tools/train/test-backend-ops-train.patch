 // FP4 W4A8 path on the MoE path (GGML_PREC_Q8 on src1 disallows 4-bit activations)
+// Xolotl (LoRA training): softmax gradients that are not trivially zero - out = softmax(scale a + mask) * w (w a fixed
+// random input), both a and the mask trainable (Inkling's relative bias is the mask), optionally a broadcast mask and
+// attention sinks.  The stock SOFT_MAX grad cases use sum(softmax) = 1 (or ~1 with sinks), whose gradient is 0.
+struct test_soft_max_grad : public test_case {
+    const std::array<int64_t, 4> ne;
+    const bool mask_bcast, sinks;
+    const float scale;
+    std::string vars() override { return VARS_TO_STR4(ne, mask_bcast, sinks, scale); }
+    test_soft_max_grad(std::array<int64_t, 4> ne = {16, 8, 3, 1}, bool mask_bcast = false, bool sinks = false, float scale = 1.0f)
+        : ne(ne), mask_bcast(mask_bcast), sinks(sinks), scale(scale) {}
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, ne[0], ne[1], ne[2], ne[3]);
+        ggml_set_param(a);
+        ggml_set_name(a, "a");
+        ggml_tensor * m = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, ne[0], ne[1], mask_bcast ? 1 : ne[2], ne[3]);
+        ggml_set_param(m);
+        ggml_set_name(m, "mask");
+        ggml_tensor * w = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, ne[0], ne[1], ne[2], ne[3]);
+        ggml_set_name(w, "w");
+        ggml_tensor * y = ggml_soft_max_ext(ctx, a, m, scale, 0.0f);
+        if (sinks) {
+            ggml_tensor * sk = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ne[2]);
+            ggml_set_name(sk, "sinks");
+            ggml_soft_max_add_sinks(y, sk);
+        }
+        ggml_tensor * out = ggml_mul(ctx, y, w);
+        ggml_set_name(out, "out");
+        return out;
+    }
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            init_tensor_uniform(t, -2.0f, 2.0f);
+        }
+    }
+    // The FD reference is noisy here (2-point at eps 0.1: MAA 1e-4..3.3e-3; smaller eps is worse, f32 SUM-loss rounding).
+    // The rule itself is checked against a double-precision analytic reference (Xolotl tools/train/smgrad_ref.cpp:
+    // tree: 16/16 at <1e-7); a wrong rule shows as an error the size of the gradient itself (0.2-1 here).
+    double max_maa_err() override { return 1e-2; }
+};
+
+// Xolotl (LoRA training): broadcast SUB backward (the subtrahend's gradient is summed over its broadcast dims).
+// out = (a - b) * w so the gradient is not a constant; output op MUL -> run with `-o MUL`.
+struct test_sub_bcast_grad : public test_case {
+    const std::array<int64_t, 4> ne;
+    const std::array<int64_t, 4> ne_b;
+    std::string vars() override { return VARS_TO_STR2(ne, ne_b); }
+    test_sub_bcast_grad(std::array<int64_t, 4> ne = {16, 5, 4, 3}, std::array<int64_t, 4> ne_b = {1, 5, 4, 3})
+        : ne(ne), ne_b(ne_b) {}
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne.data());
+        ggml_set_param(a);
+        ggml_set_name(a, "a");
+        ggml_tensor * b = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne_b.data());
+        ggml_set_param(b);
+        ggml_set_name(b, "b_sub");
+        ggml_tensor * w = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne.data());
+        ggml_set_name(w, "w");
+        ggml_tensor * out = ggml_mul(ctx, ggml_sub(ctx, a, b), w);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
