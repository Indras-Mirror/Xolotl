# tools/xolotl/apparmor/xolotl-engines - the Xolotl engines get no internet sockets (AppArmor 4, Linux).
#
# The engines (strata, xolotl-dense, ds41_generate, glm_generate, strata-vision) talk to the server only
# through stdin / stdout and link no network library, so this changes nothing they do. It is defence in depth: if a
# crafted model file ever exploited a parser bug, the process still could not open a connection anywhere. The Python
# server (serve/) is not confined: it has to listen on 127.0.0.1 for your apps.
#
# Install (root, once; again after moving the checkout):
#   sudo cp tools/xolotl/apparmor/xolotl-engines /etc/apparmor.d/xolotl-engines
#   sudo apparmor_parser -r /etc/apparmor.d/xolotl-engines
# Check: start any model, then   cat /proc/$(pgrep -x xolotl-dense)/attr/current   -> "xolotl-engine (enforce)"
# Remove: sudo apparmor_parser -R /etc/apparmor.d/xolotl-engines && sudo rm /etc/apparmor.d/xolotl-engines
#
# The attachment matches the engine names in any checkout's build-xolotl/ or build-vision/bin/. xolotl-lfm3 is left
# out: next to another model it calls that server's /v1/vram on localhost (park / unpark), which needs a TCP socket.
#
# attach_disconnected: the CUDA driver hands the engines files with no path (memfd / unlinked shared memory); without
# the flag AppArmor logs "Failed name lookup - disconnected path" and denies getattr / mmap on them (seen 8 Nov 2026).
#
# NOTE for whoever changes an engine: any network use in a listed engine (socket, curl, HTTP, even 127.0.0.1) is
# DENIED here, and the engine fails with "Permission denied". Look for it with
#   journalctl -k | grep 'profile="xolotl-engine"'
# and keep networking in the Python server, or drop that engine's name from the list below.

abi <abi/4.0>,
include <tunables/global>

profile xolotl-engine /**/build-{xolotl,vision/bin}/{strata,xolotl-dense,strata-dense,ds41_generate,glm_generate,ds4_generate,strata-vision} flags=(attach_disconnected) {
  # everything an engine does: files (model, packs, caches, logs), /dev/nvidia*, raw block reads of Engram, pinned
  # memory, threads, signals, CUDA's IPC (MPS) over unix sockets
  file,
  capability,
  signal,
  ptrace (read),
  unix,
  dbus,
  mqueue,
  io_uring,

  # what is left of networking: local unix sockets and netlink (device queries) only
  network unix,
  network netlink,
  deny network inet,
  deny network inet6,
  deny network packet,
  deny network bluetooth,
}
