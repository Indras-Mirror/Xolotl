+struct ggml_tensor * ggml_dsv41_route_weights(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * scores,
+        struct ggml_tensor  * ids,
+        bool                  norm,
+        float                 scale) {
+    GGML_ASSERT(scores->type == GGML_TYPE_F32 && scores->nb[0] == sizeof(float) && ggml_is_matrix(scores));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->nb[0] == sizeof(int32_t) && ggml_is_matrix(ids));   // ggml_argsort_top_k's view
+    GGML_ASSERT(ids->ne[1] == scores->ne[1] && ids->ne[0] <= 32);
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ids->ne[0], ids->ne[1]);
+    ggml_set_op_params_i32(result, 0, norm ? 1 : 0);
+    ggml_set_op_params_f32(result, 1, scale);
+    result->op     = GGML_OP_DSV41_ROUTE_WEIGHTS;
+    result->src[0] = scores;
+    result->src[1] = ids;
+    return result;
+}
