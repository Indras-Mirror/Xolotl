+void ggml_cuda_op_dsv41_route(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x  = dst->src[0];
+    const ggml_tensor * b0 = dst->src[1];
+    const ggml_tensor * b1 = dst->src[2];
+    const ggml_tensor * wt = dst->src[4];
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && b0->type == GGML_TYPE_F32 && b1->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_I32 && (!wt || wt->type == GGML_TYPE_F32));
+    const int   k     = ggml_get_op_params_i32(dst, 0);
+    const int   norm  = ggml_get_op_params_i32(dst, 1);
+    const float scale = ggml_get_op_params_f32(dst, 2);
+    const int ncols = (int) x->ne[0];
+    const int nrows = (int) x->ne[1];
+    const int64_t sx   = x->nb[1] / sizeof(float);
+    const int64_t sids = dst->nb[1] / sizeof(int32_t);
+    const int64_t swts = wt ? wt->nb[1] / sizeof(float) : 0;
+    const float * x_d  = (const float *) x->data;
+    const float * b0_d = (const float *) b0->data;
+    const float * b1_d = (const float *) b1->data;
+    const float * bvl_d = dst->src[5] ? (const float *) dst->src[5]->data : nullptr;
+    const float * msk_d = dst->src[6] ? (const float *) dst->src[6]->data : nullptr;
+    GGML_ASSERT((bvl_d == nullptr) == (msk_d == nullptr));
+    int *   ids_d = (int *) dst->data;
+    float * wts_d = wt ? (float *) wt->data : nullptr;
+    const int npl = (ncols + 31) / 32;
+    const ggml_cuda_kernel_launch_params params(dim3(nrows, 1, 1), dim3(32 * npl, 1, 1), 0, ctx.stream());
+#define ROUTE_NPL(N) if (npl <= N) { ggml_cuda_kernel_launch(k_dsv41_route<N>, params, x_d, b0_d, bvl_d, msk_d, b1_d, ids_d, wts_d, ncols, k, sx, sids, swts, norm, scale); return; }
+    ROUTE_NPL(1) ROUTE_NPL(2) ROUTE_NPL(4) ROUTE_NPL(8) ROUTE_NPL(12) ROUTE_NPL(16) ROUTE_NPL(24) ROUTE_NPL(32)
+#undef ROUTE_NPL
