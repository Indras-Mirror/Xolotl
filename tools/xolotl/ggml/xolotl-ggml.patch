+#include "ggml-quants.h"   // Xolotl: dequantize_row_tqp*
+// Xolotl: pair trellis TQP5/6/7 on the CPU - decode a block (ggml-base's to_float) and dot it with the f32 row.
+// Correct, not fast (the engines run trellis experts on the GPU; this serves --cpu-exps and tests).
+#define XOLOTL_TQP_VEC_DOT(K)                                                                                      \
+static void ggml_vec_dot_tqp##K##_f32(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,   \
+                                      size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {             \
+    GGML_UNUSED(bs); GGML_UNUSED(bx); GGML_UNUSED(by); GGML_UNUSED(nrc);                                          \
+    const float * y = (const float *) vy;                                                                         \
+    const uint8_t * x = (const uint8_t *) vx;                                                                     \
+    float tmp[128];                                                                                               \
+    double sum = 0.0;                                                                                             \
+    for (int ib = 0; ib < n / 128; ++ib) {                                                                        \
+        dequantize_row_tqp##K(x + (size_t) ib * (2 + 8 * K), tmp, 128);                                           \
+        float acc = 0.0f;                                                                                         \
+        for (int i = 0; i < 128; ++i) acc += tmp[i] * y[128 * ib + i];                                            \
+        sum += acc;                                                                                               \
+    }                                                                                                             \
+    *s = (float) sum;                                                                                             \
+}
+XOLOTL_TQP_VEC_DOT(5)
+XOLOTL_TQP_VEC_DOT(6)
+XOLOTL_TQP_VEC_DOT(7)
+#undef XOLOTL_TQP_VEC_DOT
+
 static const struct ggml_type_traits_cpu type_traits_cpu[GGML_TYPE_COUNT] = {
+    [GGML_TYPE_TQP5] = { .vec_dot = ggml_vec_dot_tqp5_f32, .vec_dot_type = GGML_TYPE_F32, .nrows = 1 },   // Xolotl
+    [GGML_TYPE_TQP6] = { .vec_dot = ggml_vec_dot_tqp6_f32, .vec_dot_type = GGML_TYPE_F32, .nrows = 1 },
