+// Metadata only: do not use cuda_graph(), which would evict old entries before
+// their paused interval is excluded, and do not touch CUDA objects or buffers.
+int64_t ggml_backend_cuda_graph_cache_shift_age(ggml_backend_t backend, int64_t paused_us) {
+    if (!ggml_backend_is_cuda(backend)) {
+        return 0;
+    }
+#ifdef USE_CUDA_GRAPH
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    const int64_t now = ggml_time_us();
+    auto shift = [&](int64_t & timestamp) {
+        if (timestamp <= 0 || paused_us <= 0) {
+            return; // zero is an uninitialized sentinel, not an old graph
+        }
+        timestamp = std::min(timestamp, now);
+        // Subtract before adding to avoid overflow, and never create a future age.
+        timestamp = paused_us >= now - timestamp ? now : timestamp + paused_us;
+    };
+    int64_t instances = 0;
+    for (const auto & entry : ctx->cuda_graphs) {
+        shift(entry.second->last_used_time);
+        instances += (int64_t) entry.second->instances.size();
+    }
+    shift(ctx->last_graph_eviction_sweep);
+    return instances;
+#else
+    (void) paused_us;
+    return 0;
+#endif
+}
