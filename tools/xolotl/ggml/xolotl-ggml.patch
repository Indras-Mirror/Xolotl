+// ---------------------------------------------------------------------------------------------
+// Xolotl: pair trellis TQP5/6/7 (K bits a step).  A 128-weight block = 2 bytes fp16 d + 8 K bytes of codes, 8 lanes of
+// 16 weights.  The tile is the Q8_0 layout (as Q2_0): each lane's 8 trellis steps decode through the SAME int8 codebook
+// the MMVQ decode kernel dots with (tq_lut_i8, one global scale), so a prompt pass computes exactly what decode
+// computes per weight; the per-32 scale slots all carry d * TQ_LUT_I8_SCALE of their block.  One MMQ_ITER_K slice of a
+// row = 2 blocks = 16 lanes, one thread per lane.  Opt-in (XOLOTL_TQP_MMQ=1, ggml_cuda_should_use_mmq) until measured.
+template <ggml_type type, int J, bool fallback> static __device__ __forceinline__ void ggml_cuda_mmq_load_tiles_tqp(
+        const char * __restrict__ x, const char * __restrict__ x_gate, int * __restrict__ x_tile, const int kbx0, const int i_max, const int stride) {
+    GGML_UNUSED(x_gate);
+    constexpr int K = type == GGML_TYPE_TQP5 ? 5 : type == GGML_TYPE_TQP6 ? 6 : 7;
+    constexpr int block_bytes = 2 + 8 * K;
+
+    constexpr int warp_size   = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps      = ggml_cuda_mmq_get_nthreads(type, J, fallback, GGML_PREC_Q8) / warp_size;
+    constexpr int I           = ggml_cuda_mmq_get_I(type, J, fallback, GGML_PREC_Q8);
+
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+    constexpr int sram_stride = ggml_cuda_mmq_get_sram_stride(type, J, fallback, GGML_PREC_Q8);
+    int   * x_qs = (int   *)  x_tile;
+    float * x_df = (float *) (x_qs + 2*MMQ_TILE_NE_K);
+#else
+    constexpr tile_x_sizes txs = mmq_get_dp4a_tile_x_sizes(GGML_TYPE_Q8_0, I);
+    int   * x_qs = (int   *)  x_tile;
+    float * x_df = (float *) (x_qs + txs.qs);
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+
+    constexpr int blocks_per_iter = MMQ_ITER_K / QK_TQP;            // 2
+    constexpr int lanes           = QK_TQP / 16;                    // 8
+    constexpr int threads_per_row = blocks_per_iter * lanes;        // 16
+    static_assert(warp_size % threads_per_row == 0, "bad warp size for the TQP tile");
+    static_assert(2*MMQ_TILE_NE_K == blocks_per_iter * lanes * 4, "a TQP slice is not one Q8_0 tile row");
+    constexpr int nrows = warp_size / threads_per_row;
+
+    const int txi  = threadIdx.x % threads_per_row;
+    const int kbx  = txi / lanes;
+    const int lane = txi % lanes;
+
+#pragma unroll
+    for (int i0 = 0; i0 < I; i0 += nrows*nwarps) {
+        int i = i0 + threadIdx.y*nrows + threadIdx.x/threads_per_row;
+
+        if (fallback) {
+            i = min(i, i_max);
+        }
+
+        const uint8_t * b = (const uint8_t *) x + (size_t) (kbx0 + i*stride + kbx) * block_bytes;
+        uint32_t s[8];
+        tqp_states8<K>(b + 2, lane, s);
+        const int q0 = kbx*(lanes*4) + lane*4;   // int index of the lane's 16 weights within the row's 64 ints
+
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {   // two steps (2 + 2 weights) per int, as vec_dot_tqp_q8_1
+            const uint32_t x0 = (s[2 * k] & 0x7fffu) * 0x9e3779b1u;
+            const uint32_t x1 = (s[2 * k + 1] & 0x7fffu) * 0x9e3779b1u;
+            const int q = (int) ((uint32_t) tq_lut_i8[x0 >> 21] | ((uint32_t) tq_lut_i8[x1 >> 21] << 16));
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+            x_qs[i*sram_stride + q0 + k] = q;
+#else
+            x_qs[i*(2*MMQ_TILE_NE_K + 1) + q0 + k] = q;
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+        }
+
+        if (lane < QK_TQP / QK8_0) {   // the block's 4 per-32 scale slots
+            const float d = __half2float(__ushort_as_half((unsigned short) (b[0] | (b[1] << 8)))) * TQ_LUT_I8_SCALE;
+            const int kd = kbx*(QK_TQP / QK8_0) + lane;
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+            x_df[i*sram_stride + kd] = d;
+#else
+            x_df[i*(2*MMQ_TILE_NE_K/QI8_0) + i/(QI8_0/2) + kd] = d;
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+        }
+    }
+}
