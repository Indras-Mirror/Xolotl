+// Strata DS4.1 (ggml_dsv41_kv_gather): a sparse attention's key rows per query in one pass.  Rows [0, na) of query q
+// are a's rows ia[j, q], rows [na, na + nb) are b's rows ib[j - na, q], the rest +0.  Every value is the one get_rows
+// writes for an F16 destination (ggml_cuda_cast<half>; dequantize_nvfp4<half> with the same 32-thread split), so the
+// result equals concat(concat(get_rows(a), get_rows(b)), zeros) byte for byte.  One warp per destination row.
+template<ggml_type type_a, ggml_type type_b>
+static __global__ void k_dsv41_kv_gather(
+        const char * __restrict__ a, const int32_t * __restrict__ ia, const char * __restrict__ b,
+        const int32_t * __restrict__ ib, half * __restrict__ dst,
+        const int ne0, const int na, const int nb, const int m, const int64_t n,
+        const size_t nba1, const size_t nbb1, const bool vec_a) {
+    const int lane = threadIdx.x;
+    const int j    = blockIdx.x*blockDim.y + threadIdx.y;
+    if (j >= m) {
+        return;
+    }
+    for (int64_t q = blockIdx.y; q < n; q += gridDim.y) {
+        half * y = dst + ((size_t) q*m + j)*ne0;
+        if (j < na) {
+            const char * x = a + (size_t) ia[q*na + j]*nba1;
+            if constexpr (type_a == GGML_TYPE_F16) {
+                for (int i = lane; i < ne0; i += WARP_SIZE) {
+                    y[i] = ((const half *) x)[i];
+                }
+            } else if (vec_a) {
+                for (int i = 4*lane; i < ne0; i += 4*WARP_SIZE) {
+                    const float4 v = *(const float4 *) ((const float *) x + i);
+                    y[i + 0] = ggml_cuda_cast<half>(v.x);
+                    y[i + 1] = ggml_cuda_cast<half>(v.y);
+                    y[i + 2] = ggml_cuda_cast<half>(v.z);
+                    y[i + 3] = ggml_cuda_cast<half>(v.w);
+                }
+            } else {
+                for (int i = lane; i < ne0; i += WARP_SIZE) {
+                    y[i] = ggml_cuda_cast<half>(((const float *) x)[i]);
+                }
+            }
+        } else if (j < na + nb) {
+            const char * x = b + (size_t) ib[q*nb + (j - na)]*nbb1;
+            if constexpr (type_b == GGML_TYPE_NVFP4) {
+                for (int sb = 0; sb < ne0/QK_K; ++sb) {
+                    dequantize_nvfp4<half>(x, sb, y + sb*QK_K, lane);
+                }
+            } else if constexpr (type_b == GGML_TYPE_F16) {
+                for (int i = lane; i < ne0; i += WARP_SIZE) {
+                    y[i] = ((const half *) x)[i];
+                }
+            } else {
+                for (int i = lane; i < ne0; i += WARP_SIZE) {
+                    y[i] = ggml_cuda_cast<half>(((const float *) x)[i]);
+                }
+            }
+        } else {
+            for (int i = lane; i < ne0; i += WARP_SIZE) {
+                y[i] = __float2half(0.0f);
+            }
+        }
+    }
+}
+
+template<ggml_type type_a>
+static void dsv41_kv_gather_cuda(const ggml_tensor * a, const ggml_tensor * ia, const ggml_tensor * b,
+        const ggml_tensor * ib, ggml_tensor * dst, cudaStream_t stream) {
+    const int ne0 = a->ne[0], na = ia->ne[0], nb = ib->ne[0], m = dst->ne[1];
+    const int64_t n = dst->ne[2];
+    const bool vec_a = type_a == GGML_TYPE_F32 && ne0 % (4*WARP_SIZE) == 0 && a->nb[1] % 16 == 0 &&
+        ((uintptr_t) a->data) % 16 == 0;
+    const dim3 block_dims(WARP_SIZE, 4, 1);
+    const dim3 block_nums((m + 3)/4, (unsigned) std::min<int64_t>(n, UINT16_MAX), 1);
+    const int32_t * ia_d = (const int32_t *) ia->data;
+    const int32_t * ib_d = (const int32_t *) ib->data;
+    switch (b->type) {
+        case GGML_TYPE_NVFP4:
+            k_dsv41_kv_gather<type_a, GGML_TYPE_NVFP4><<<block_nums, block_dims, 0, stream>>>((const char *) a->data, ia_d,
+                (const char *) b->data, ib_d, (half *) dst->data, ne0, na, nb, m, n, a->nb[1], b->nb[1], vec_a);
+            break;
+        case GGML_TYPE_F16:
+            k_dsv41_kv_gather<type_a, GGML_TYPE_F16><<<block_nums, block_dims, 0, stream>>>((const char *) a->data, ia_d,
+                (const char *) b->data, ib_d, (half *) dst->data, ne0, na, nb, m, n, a->nb[1], b->nb[1], vec_a);
+            break;
+        case GGML_TYPE_F32:
+            k_dsv41_kv_gather<type_a, GGML_TYPE_F32><<<block_nums, block_dims, 0, stream>>>((const char *) a->data, ia_d,
+                (const char *) b->data, ib_d, (half *) dst->data, ne0, na, nb, m, n, a->nb[1], b->nb[1], vec_a);
+            break;
+        default:
+            GGML_ABORT("%s: unsupported b type: %s\n", __func__, ggml_type_name(b->type));
+    }
+}
+
+void ggml_cuda_op_dsv41_kv_gather(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * a  = dst->src[0];
+    const ggml_tensor * ia = dst->src[1];
+    const ggml_tensor * b  = dst->src[2];
+    const ggml_tensor * ib = dst->src[3];
+    GGML_ASSERT(dst->type == GGML_TYPE_F16 && ggml_is_contiguous(dst));
+    GGML_ASSERT(a->nb[0] == ggml_type_size(a->type) && b->nb[0] == ggml_type_size(b->type));
+    GGML_ASSERT(b->type != GGML_TYPE_NVFP4 || b->ne[0] % QK_K == 0);
+    if (a->type == GGML_TYPE_F16) {
