+struct ggml_tensor * ggml_dsv41_route(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * logits,
+        struct ggml_tensor  * b0,
+        struct ggml_tensor  * b1,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * wts,
+        int                   k,
+        bool                  norm,
+        float                 scale) {
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && b0->type == GGML_TYPE_F32 && b1->type == GGML_TYPE_F32);
+    GGML_ASSERT(logits->nb[0] == sizeof(float) && logits->ne[2] == 1 && logits->ne[3] == 1);
+    GGML_ASSERT(ggml_is_contiguous(b0) && ggml_is_contiguous(b1));
+    GGML_ASSERT(ggml_nelements(b0) == logits->ne[0] && ggml_nelements(b1) == logits->ne[0]);
+    GGML_ASSERT(k >= 1 && k <= 32 && k <= logits->ne[0] && logits->ne[0] <= 1024);
+    const int64_t n = logits->ne[1];
+    GGML_ASSERT(!ids || (ids->type == GGML_TYPE_I32 && ids->ne[0] == k && ids->ne[1] == n && ids->nb[0] == sizeof(int32_t)));
+    GGML_ASSERT(!wts || (wts->type == GGML_TYPE_F32 && wts->ne[0] == k && wts->ne[1] == n && wts->nb[0] == sizeof(float)));
+    struct ggml_tensor * result = ids ? ggml_view_tensor(ctx, ids) : ggml_new_tensor_2d(ctx, GGML_TYPE_I32, k, n);
+    ggml_set_op_params_i32(result, 0, k);
+    ggml_set_op_params_i32(result, 1, norm ? 1 : 0);
+    ggml_set_op_params_f32(result, 2, scale);
+    result->op     = GGML_OP_DSV41_ROUTE;
+    result->src[0] = logits;
+    result->src[1] = b0;
+    result->src[2] = b1;
+    result->src[3] = ids;
+    result->src[4] = wts;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_route_vl(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * logits,
+        struct ggml_tensor  * b0,
+        struct ggml_tensor  * bvl,
+        struct ggml_tensor  * mask,
+        struct ggml_tensor  * b1,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * wts,
+        int                   k,
+        bool                  norm,
+        float                 scale) {
+    GGML_ASSERT(bvl->type == GGML_TYPE_F32 && ggml_is_contiguous(bvl) && ggml_nelements(bvl) == logits->ne[0]);
+    GGML_ASSERT(mask->type == GGML_TYPE_F32 && ggml_is_contiguous(mask) && ggml_nelements(mask) == logits->ne[1]);
+    struct ggml_tensor * result = ggml_dsv41_route(ctx, logits, b0, b1, ids, wts, k, norm, scale);
+    result->src[5] = bvl;
+    result->src[6] = mask;
+    return result;
+}
