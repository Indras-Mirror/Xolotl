+        CUDA_CHECK(cudaEventCreateWithFlags(&ev, cudaEventDisableTiming));
+    }
+    if (mode == 0) {
+        GGML_ASSERT(ctx.curr_stream_no == 0);
+        CUDA_CHECK(cudaEventRecord(ev, ctx.stream()));
+        CUDA_CHECK(cudaStreamWaitEvent(ctx.stream(ctx.device, k), ev));
+        ctx.curr_stream_no = k;
+    } else if (mode == 1) {
+        GGML_ASSERT(ctx.curr_stream_no == k);
+        CUDA_CHECK(cudaEventRecord(ev, ctx.stream()));
+        ctx.curr_stream_no = 0;
+    } else {
+        GGML_ASSERT(ctx.curr_stream_no == 0);
+        CUDA_CHECK(cudaStreamWaitEvent(ctx.stream(), ev));
+    }
