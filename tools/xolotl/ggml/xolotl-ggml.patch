+// xolotl: drop every CUDA graph this backend has cached.  A cached graph's kernels point at the buffers of the ggml
+// context that built it.  When a caller frees that context and builds a new one of the same size (the GLM engine
+// does this when its one fixed graph pool fills up), the new context and its buffers land at the same addresses,
+// the cache key (cgraph->nodes[0]) collides, and the next compute replays a stale executable against freed memory:
+// "ds4_moe: chunk sync: an illegal memory access was encountered" and a SIGSEGV in ggml_backend_cuda_graph_compute.
+// Call this before freeing the context.  No-op when the backend is not CUDA.
+GGML_BACKEND_API void ggml_backend_cuda_graph_cache_clear(ggml_backend_t backend);
+
+// Exclude an externally checkpointed idle interval from CUDA graph eviction ages.
+// The caller must prevent graph execution/cache mutation throughout that interval
+// and call this after restore/unlock, before the next graph lookup. Preserves graph
+// executables and tensor storage; no CUDA calls or allocations. Positive paused_us
+// advances nonzero age timestamps, capped at the current monotonic time. Returns
+// the number of retained executable instances (zero for non-CUDA/non-graph builds).
+GGML_BACKEND_API int64_t ggml_backend_cuda_graph_cache_shift_age(ggml_backend_t backend, int64_t paused_us);
+// xolotl: the backend's main stream (a cudaStream_t), so work outside ggml can wait for its graphs or make it wait.
+// Every graph ends on this stream (concurrent branches join back to it).  NULL when the backend is not CUDA.
+GGML_BACKEND_API void * ggml_backend_cuda_get_stream(ggml_backend_t backend);
+
 // device buffer
 GGML_BACKEND_API ggml_backend_buffer_type_t ggml_backend_cuda_buffer_type(int device);
 
