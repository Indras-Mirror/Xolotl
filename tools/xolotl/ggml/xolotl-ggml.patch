+// The same two packers with one thread per value (set_rows with GGML_CUDA_FP4_PACK=1): x is value j of block y, and
+// the 32 lanes of the warp hold 32 consecutive values of the block in order. The lanes of a (sub-)block vote on each
+// candidate scale and keep the first one all of them reproduce: the same scales and codes as the loops above.
+// CUDA only (32-lane warps and the warp votes).
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+static __device__ __forceinline__ void quantize_f32_nvfp4_ds41_lane(const float x, block_nvfp4 * __restrict__ y, const int j) {
+    float amax = fmaxf(0.0f, fabsf(x));
+#pragma unroll
+    for (int o = QK_NVFP4_SUB/2; o > 0; o >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, o, QK_NVFP4_SUB));
+    float s = 0x1p-9f;
+    bool exact = amax == 0.0f;
+    const float qm[7] = { 6.0f, 4.0f, 3.0f, 2.0f, 1.5f, 1.0f, 0.5f };
+    const int sh = j & 16;                                   // this sub-block's bits in the warp ballot
+    for (int k = 0; k < 7; ++k) {                            // every lane runs all 7 (the ballot needs the whole warp)
+        const float c = ds41_round_e4m3(amax / qm[k]);
+        const bool ok = c > 0.0f && ds41_e2m1_exact(x, c) >= 0;
+        const bool all = ((__ballot_sync(0xffffffff, ok) >> sh) & 0xffff) == 0xffff;
+        if (!exact && all) { s = c; exact = true; }
+    }
+    if (!exact) s = fmaxf(ds41_round_e4m3(amax / 6.0f), 0x1p-9f);
+    int c = ds41_e2m1_exact(x, s);
+    if (c < 0) c = ds41_e2m1_nearest(x / s) | (x < 0.0f ? 8 : 0);
+    const int c1 = __shfl_down_sync(0xffffffff, c, QK_NVFP4_SUB/2, QK_NVFP4_SUB);
+    const int sb = j / QK_NVFP4_SUB, l = j % QK_NVFP4_SUB;
+    if (l == 0) y->d[sb] = ds41_e4m3_bits(s);
+    if (l < QK_NVFP4_SUB/2) y->qs[sb*(QK_NVFP4_SUB/2) + l] = (uint8_t) (c | (c1 << 4));
+}
+
+static __device__ __forceinline__ void quantize_f32_mxfp4_ds41_lane(const float x, block_mxfp4 * __restrict__ y, const int j) {
+    float amax = fmaxf(0.0f, fabsf(x));
+#pragma unroll
+    for (int o = QK_MXFP4/2; o > 0; o >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, o, QK_MXFP4));
+    int E = -127;
+    if (amax > 0.0f) {                                       // the same for the whole warp (= the block)
+        int e; frexpf(amax, &e);
+        bool found = false;
+        for (int k = 0; k < 4; ++k) {
+            const int t = e - 3 + (k == 0 ? 0 : k == 1 ? 1 : k == 2 ? -1 : 2);
+            const bool all = __all_sync(0xffffffff, ds41_e2m1_exact(x, ldexpf(1.0f, t)) >= 0);
+            if (!found && all) { E = t; found = true; }
+        }
+        if (!found) { int e2; frexpf(amax / 6.0f, &e2); E = e2; }
+    }
+    E = max(-126, min(127, E));
+    const float s = ldexpf(1.0f, E);
+    int c = ds41_e2m1_exact(x, s);
+    if (c < 0) c = ds41_e2m1_nearest(x / s) | (x < 0.0f ? 8 : 0);
+    const int c1 = __shfl_down_sync(0xffffffff, c, QK_MXFP4/2, QK_MXFP4);
+    if (j == 0) y->e = (uint8_t) (E + 127);
+    if (j < QK_MXFP4/2) y->qs[j] = (uint8_t) (c | (c1 << 4));
