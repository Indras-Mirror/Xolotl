+struct ggml_tensor * ggml_dsv41_route_scores(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * logits,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * bias_vl,
+        struct ggml_tensor  * img,
+        struct ggml_tensor  * rbias) {
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && ggml_is_contiguous(logits));
+    const int64_t ne = logits->ne[0];
+    const int64_t nt = logits->ne[1] * logits->ne[2] * logits->ne[3];
+    GGML_ASSERT(bias->type  == GGML_TYPE_F32 && ggml_is_contiguous(bias)  && ggml_nelements(bias)  == ne);
+    GGML_ASSERT(rbias->type == GGML_TYPE_F32 && ggml_is_contiguous(rbias) && ggml_nelements(rbias) == ne);
+    GGML_ASSERT((bias_vl == NULL) == (img == NULL));
+    if (bias_vl) {
+        GGML_ASSERT(bias_vl->type == GGML_TYPE_F32 && ggml_is_contiguous(bias_vl) && ggml_nelements(bias_vl) == ne);
+        GGML_ASSERT(img->type == GGML_TYPE_F32 && ggml_is_contiguous(img) && ggml_nelements(img) == nt);
+    }
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, ne, nt, 2);
+    result->op     = GGML_OP_DSV41_ROUTE_SCORES;
+    result->src[0] = logits;
+    result->src[1] = bias;
+    result->src[2] = rbias;
+    result->src[3] = bias_vl;
+    result->src[4] = img;
+    return result;
+}
