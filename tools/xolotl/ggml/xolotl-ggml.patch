+struct ggml_tensor * ggml_dsv41_copies(
+        struct ggml_context * ctx,
+        struct ggml_tensor ** srcs,
+        struct ggml_tensor ** dsts,
+        int                   n) {
+    GGML_ASSERT(n >= 1 && 2*n <= GGML_MAX_SRC);
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+    for (int i = 0; i < n; ++i) {
+        GGML_ASSERT(srcs[i]->type == dsts[i]->type && ggml_type_size(srcs[i]->type) == 4 && ggml_blck_size(srcs[i]->type) == 1);
+        GGML_ASSERT(ggml_nelements(srcs[i]) == ggml_nelements(dsts[i]));
+        result->src[2*i + 0] = srcs[i];
+        result->src[2*i + 1] = dsts[i];
+    }
+    ggml_set_op_params_i32(result, 0, n);
+    result->op = GGML_OP_DSV41_COPIES;
+    return result;
+}
