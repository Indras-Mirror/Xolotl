+// ggml_compute_forward_dsv41_hc_mixes (Strata-DS4): the two HC mixes of one model.py Block.hc_mixes.  The same steps,
+// in the same order, as the engine's stock-op composite (ggml_compute_forward_mul -> ggml_vec_mul_f32,
+// ggml_compute_forward_add -> ggml_vec_add_f32, ggml_compute_forward_sigmoid -> ggml_vec_sigmoid_f32,
+// ggml_compute_forward_scale -> ggml_vec_scale_f32 / ggml_vec_mad1_f32): one plain product, one plain sum (volatile:
+// the product must round on its own, GNU mode contracts a*b+c into fma and the composite is two ops), the sigmoid, and
+// s*1 + eps / s*2 + 0 (exactly the scale the composite applies, `fma(x, 1, eps)` == `x + eps`).
+void ggml_compute_forward_dsv41_hc_mixes(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * mixes = dst->src[0];
+    const ggml_tensor * scale = dst->src[1];
+    const ggml_tensor * base  = dst->src[2];
+    GGML_ASSERT(mixes->type == GGML_TYPE_F32 && ggml_is_contiguous(mixes));
+    GGML_ASSERT(scale->type == GGML_TYPE_F32 && ggml_nelements(scale) == 2);
+    GGML_ASSERT(base->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(mixes->ne[0] >= 2 * (base->ne[0] / 2));
+    const int64_t hc = base->ne[0] / 2;
+    const int64_t nt = dst->ne[1] / 2;
+    const int64_t nrow = mixes->ne[0];   // 2*hc; a Block.hc_mixes mixes tensor carries the comb rows after them
+    const float   eps = ggml_get_op_params_f32(dst, 0);
+    const float * mx = (const float *) mixes->data;
+    const float * sc = (const float *) scale->data;
+    const float * bs = (const float *) base->data;
+    float * y = (float *) dst->data;
+    const int64_t n = 2*hc*nt;
+    const int64_t i0 = n * params->ith / params->nth;
+    const int64_t i1 = n * (params->ith + 1) / params->nth;
+    for (int64_t i = i0; i < i1; ++i) {
+        const int64_t h    = i % hc;
+        const int64_t col  = i / hc;
+        const bool    post = col >= nt;
+        const int64_t t    = post ? col - nt : col;
+        const int64_t r    = post ? hc + h : h;
+        const volatile float t0 = mx[r + nrow*t] * sc[post ? 1 : 0];
+        const float t1 = t0 + bs[r];
+        const float s  = 1.0f / (1.0f + expf(-t1));
+        y[i] = post ? s * 2.0f : s + eps;
+    }
+}
+
+// ggml_compute_forward_dsv41_route_scores (Strata-DS4): model.py Gate's scores and selection scores, the engine's
+// stock-op composite step for step - unary-ops.cpp op_softplus, ggml_vec_sqrt_f32's sqrtf, the vision bias select
+// (sub, repeat, mul, add: one plain op each, volatile so GNU mode cannot contract the product into the add), then the
+// two adds.
+void ggml_compute_forward_dsv41_route_scores(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * logits  = dst->src[0];
+    const ggml_tensor * bias    = dst->src[1];
+    const ggml_tensor * rbias   = dst->src[2];
+    const ggml_tensor * bias_vl = dst->src[3];
+    const ggml_tensor * img     = dst->src[4];
+    const int64_t ne = logits->ne[0];
+    const int64_t nt = dst->ne[1];
+    const float * x  = (const float *) logits->data;
+    const float * bt = (const float *) bias->data;
+    const float * rb = (const float *) rbias->data;
+    const float * bv = bias_vl ? (const float *) bias_vl->data : nullptr;
+    const float * m  = img ? (const float *) img->data : nullptr;
+    float * y = (float *) dst->data;
+    const int64_t n  = ne*nt;
+    const int64_t i0 = n * params->ith / params->nth;
+    const int64_t i1 = n * (params->ith + 1) / params->nth;
+    for (int64_t i = i0; i < i1; ++i) {
+        const int64_t e = i % ne;
+        const int64_t t = i / ne;
+        const float v  = x[i];
+        const float sp = (v > 20.0f) ? v : log1pf(expf(v));
+        const float s  = sqrtf(sp);
+        float b = bt[e];
+        if (bv) {
+            const float d = bv[e] - bt[e];
+            const volatile float dm = d * m[t];
+            b = dm + bt[e];
+        }
+        const float s0 = s + b;
+        y[i]     = s;
+        y[n + i] = s0 + rb[e];
+    }
+}
+
+// ggml_compute_forward_dsv41_route_weights (Strata-DS4): get_rows of the k selected scores, then (norm) the row sum as
+// ggml_vec_sum_f32 takes it (a double accumulator, in order), ggml_scale_bias(1, 1e-20), the division, ggml_scale.
+void ggml_compute_forward_dsv41_route_weights(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * scores = dst->src[0];
+    const ggml_tensor * ids    = dst->src[1];
+    const int64_t k  = dst->ne[0];
+    const int64_t nt = dst->ne[1];
+    const bool  norm  = ggml_get_op_params_i32(dst, 0) != 0;
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int64_t t0 = nt * params->ith / params->nth;
+    const int64_t t1 = nt * (params->ith + 1) / params->nth;
+    for (int64_t t = t0; t < t1; ++t) {
+        const float * sc = (const float *) ((const char *) scores->data + t*scores->nb[1]);
+        float * w = (float *) dst->data + t*k;
+        for (int64_t j = 0; j < k; ++j) {
+            w[j] = sc[((const int32_t *) ((const char *) ids->data + t*ids->nb[1]))[j]];
+        }
+        if (norm) {
+            ggml_float sum = 0.0;
+            for (int64_t j = 0; j < k; ++j) {
+                sum += (ggml_float) w[j];
+            }
+            const volatile float s = (float) sum;
+            const float d = s*1.0f + 1e-20f;
+            for (int64_t j = 0; j < k; ++j) {
+                w[j] = w[j] / d;
+            }
+        }
+        for (int64_t j = 0; j < k; ++j) {
+            w[j] *= scale;
+        }
+    }
+}
+
+// ggml_compute_forward_dsv41_copies (Strata-DS4): up to 5 same-type 4-byte copies, element i of each pair's src (in
+// its own index order) to element i of its dst (in the dst's), as ggml_cpy does
+void ggml_compute_forward_dsv41_copies(const ggml_compute_params * params, ggml_tensor * dst) {
+    const int n = ggml_get_op_params_i32(dst, 0);
+    for (int p = 0; p < n; ++p) {
+        const ggml_tensor * s = dst->src[2*p + 0];
+        const ggml_tensor * d = dst->src[2*p + 1];
+        const int64_t ne = ggml_nelements(s);
+        const int64_t i0 = ne * params->ith / params->nth;
+        const int64_t i1 = ne * (params->ith + 1) / params->nth;
+        for (int64_t i = i0; i < i1; ++i) {
+            int64_t r = i;
+            const int64_t s0 = r % s->ne[0]; r /= s->ne[0];
+            const int64_t s1 = r % s->ne[1]; r /= s->ne[1];
+            const int64_t s2 = r % s->ne[2]; r /= s->ne[2];
+            r = i;
+            const int64_t d0 = r % d->ne[0]; r /= d->ne[0];
+            const int64_t d1 = r % d->ne[1]; r /= d->ne[1];
+            const int64_t d2 = r % d->ne[2]; r /= d->ne[2];
+            const char * ps = (const char *) s->data + s0*s->nb[0] + s1*s->nb[1] + s2*s->nb[2] + (i / (s->ne[0]*s->ne[1]*s->ne[2]))*s->nb[3];
+            char * pd = (char *) d->data + d0*d->nb[0] + d1*d->nb[1] + d2*d->nb[2] + (i / (d->ne[0]*d->ne[1]*d->ne[2]))*d->nb[3];
+            memcpy(pd, ps, 4);
+        }
+    }
+}
+
+// Xolotl (LoRA training): dst[:, e % ne11, t] += as[ids[e, t]]^T g[:, e, t] (the gradient of mul_mat_id w.r.t. b).
+// Each thread owns a block-aligned slice [k0, k0 + nk) of K: it zeroes that slice of every dst column, then walks the
+// experts (its own bucket of the routing), dequantizes its slice of every expert row once and adds g-weighted copies
+// into the routed columns. Threads never write the same bytes, so there is no barrier and no reduction.
+size_t ggml_compute_mul_mat_id_back_wsize_per_thread(const struct ggml_tensor * dst) {
+    const ggml_tensor * as  = dst->src[0];
+    const ggml_tensor * ids = dst->src[2];
+    const size_t wf = GGML_PAD((size_t) as->ne[0] * sizeof(float), 64);
+    const size_t wi = GGML_PAD((size_t) (2 * (as->ne[2] + 1) + 2 * ids->ne[0] * ids->ne[1]) * sizeof(int64_t), 64);
+    return wf + wi;
+}
+
+void ggml_compute_forward_mul_mat_id_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * as  = dst->src[0];
+    const ggml_tensor * g   = dst->src[1];
+    const ggml_tensor * ids = dst->src[2];
+
+    GGML_ASSERT(g->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 && ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(g->nb[0] == sizeof(float) && dst->nb[0] == sizeof(float));
+
+    const int64_t K = as->ne[0], M = as->ne[1], E = as->ne[2];
+    const int64_t n_used = ids->ne[0], T = ids->ne[1], ne11 = dst->ne[1];
+
+    const int ith = params->ith, nth = params->nth;
+    const int64_t bs = ggml_blck_size(as->type);
+    GGML_ASSERT(K % bs == 0);
+    const int64_t nblk = K / bs;
+    const int64_t kb0 = nblk * ith / nth, kb1 = nblk * (ith + 1) / nth;
+    const int64_t k0 = kb0 * bs, nk = (kb1 - kb0) * bs;
+    if (nk == 0) {
+        return;
+    }
+
+    for (int64_t t = 0; t < T; ++t) {
+        for (int64_t j = 0; j < ne11; ++j) {
+            memset((char *) dst->data + j * dst->nb[1] + t * dst->nb[2] + k0 * sizeof(float), 0, nk * sizeof(float));
+        }
+    }
+
+    const size_t per = ggml_compute_mul_mat_id_back_wsize_per_thread(dst);
+    GGML_ASSERT(params->wsize >= per * (size_t) nth);
+    char * wd = (char *) params->wdata + per * (size_t) ith;
+    float   * w   = (float *) wd;
+    int64_t * cnt = (int64_t *) (wd + GGML_PAD((size_t) K * sizeof(float), 64));   // E + 1
+    int64_t * pos = cnt + (E + 1);                                                  // E + 1
+    int64_t * pe  = pos + (E + 1);                                                  // n_used * T
+    int64_t * pt  = pe + n_used * T;                                                // n_used * T
+
+    auto expert_of = [&](int64_t e, int64_t t) -> int32_t {
+        return *(const int32_t *) ((const char *) ids->data + e * ids->nb[0] + t * ids->nb[1]);
+    };
+    memset(cnt, 0, (E + 1) * sizeof(int64_t));
+    for (int64_t t = 0; t < T; ++t) {
+        for (int64_t e = 0; e < n_used; ++e) {
+            const int32_t x = expert_of(e, t);
+            if (x >= 0 && x < E) {
+                cnt[x + 1]++;
+            }
+        }
+    }
+    for (int64_t x = 0; x < E; ++x) {
+        cnt[x + 1] += cnt[x];
+    }
+    memcpy(pos, cnt, (E + 1) * sizeof(int64_t));
+    for (int64_t t = 0; t < T; ++t) {
+        for (int64_t e = 0; e < n_used; ++e) {
+            const int32_t x = expert_of(e, t);
+            if (x >= 0 && x < E) {
+                const int64_t p = pos[x]++;
+                pe[p] = e;
+                pt[p] = t;
+            }
+        }
+    }
+
+    const ggml_to_float_t to_float = as->type == GGML_TYPE_F32 ? nullptr : ggml_get_type_traits(as->type)->to_float;
+    GGML_ASSERT(as->type == GGML_TYPE_F32 || to_float != nullptr);
+    const size_t koff = (size_t) kb0 * ggml_type_size(as->type);
+
+    for (int64_t x = 0; x < E; ++x) {
+        if (cnt[x + 1] == cnt[x]) {
+            continue;
+        }
+        for (int64_t m = 0; m < M; ++m) {
+            const char * row = (const char *) as->data + x * as->nb[2] + m * as->nb[1] + koff;
+            const float * wp;
+            if (to_float) {
+                to_float(row, w, nk);
+                wp = w;
+            } else {
+                wp = (const float *) row;
+            }
+            for (int64_t p = cnt[x]; p < cnt[x + 1]; ++p) {
+                const int64_t e = pe[p], t = pt[p];
+                const float gm = *(const float *) ((const char *) g->data + m * sizeof(float) + e * g->nb[1] + t * g->nb[2]);
+                if (gm == 0.0f) {
+                    continue;
+                }
+                float * d = (float *) ((char *) dst->data + (e % ne11) * dst->nb[1] + t * dst->nb[2]) + k0;
+                ggml_vec_mad_f32((int) nk, d, wp, gm);
             }
