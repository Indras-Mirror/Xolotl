+    for (int j = 0; j < k; ++j) {
+        unsigned long long m = best;
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            const unsigned long long o = __shfl_xor_sync(0xFFFFFFFFu, m, off);
+            m = o < m ? o : m;
+        }
+        const int col = (int) (m & 0xFFFFFFFFull);
+        if (lane == 0) {
+            dst_row[j] = col;
+        }
+        if (lane == (col & 31)) {   // the winner drops that column and rescans its own
+            best = ~0ull;
+#pragma unroll
+            for (int i = 0; i < NPL; ++i) {
