+// ---- Xolotl: pair trellis TQP5/6/7 x q8_1 (transcribed from Strata's src/kernels/cuda/iq_kernels.cu, itself from the
+// agentionai fork's tq.cuh).  Lane l = iqs / 4 holds weights 16 l .. 16 l + 15 (steps 8 l .. 8 l + 7); the int8 copy of
+// the codebook (tq-lut-i8.cuh, one global scale, rel. RMS 0.0085 of the codebook std) dots with q8_1 block l / 2,
+// ints 4 (l & 1) .. 4 (l & 1) + 3.  The prompt path dequantizes with the fp16 codebook (convert.cu).
+#include "tq-lut-i8.cuh"
+#define VDR_TQP_Q8_1_MMVQ 4
+template <int K>
+static __device__ __forceinline__ void tqp_states8(const uint8_t * __restrict__ qs, const int lane, uint32_t s[8]) {
+    constexpr int NB = 8 * K, NW = K + 2 < 8 ? K + 2 : 8;
+    const int pidx = (7 - lane) * K;          // the lane's first byte, always < NB
+    uint64_t w = 0;
+#pragma unroll
+    for (int j = 0; j < NW; ++j) {
+        const int idx0 = pidx + j;
+        w |= (uint64_t) qs[idx0 < NB ? idx0 : idx0 - NB] << (8 * j);
+    }
+    const int i8 = pidx + 8;
+    const uint32_t hi = K == 7 ? (uint32_t) qs[i8 < NB ? i8 : i8 - NB] : 0u;   // K = 7: the 65th bit
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const int sh = (7 - i) * K;
+        const uint32_t lo = (uint32_t) (w >> sh);
+        const uint32_t top = sh > 48 ? (uint32_t) (hi << (64 - sh)) : 0u;
+        s[i] = (lo | top) & 0xFFFFu;
+    }
