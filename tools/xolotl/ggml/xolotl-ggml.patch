+    const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs) {
+    const uint8_t * b = (const uint8_t *) vbq + (size_t) kbx * (2 + 8 * K);
+    const int l = iqs / 4;
+    uint32_t s[8];
+    tqp_states8<K>(b + 2, l, s);
+    const block_q8_1 * b8 = bq8_1 + l / 2;
+    const int * q8 = (const int *) b8->qs + 4 * (l & 1);
+    int sumi = 0;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {   // two steps (2 + 2 weights) per int
+        const uint32_t x0 = (s[2 * i] & 0x7fffu) * 0x9e3779b1u;
+        const uint32_t x1 = (s[2 * i + 1] & 0x7fffu) * 0x9e3779b1u;
+        const int q = (int) ((uint32_t) tq_lut_i8[x0 >> 21] | ((uint32_t) tq_lut_i8[x1 >> 21] << 16));
+        sumi = ggml_cuda_dp4a(q, q8[i], sumi);
+    }
+    const float d = __half2float(__ushort_as_half((unsigned short) (b[0] | (b[1] << 8))));
+    return d * (__low2float(b8->ds) * TQ_LUT_I8_SCALE) * (float) sumi;
+}
