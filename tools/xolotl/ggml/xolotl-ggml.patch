+
+static __device__ __forceinline__ float dsv41_fq_pow2_floor(float a) {
+    const float f = dsv41_fq_pow2_ceil(a);
+    return __fmul_rn(f, dsv41_fq_scale(dsv41_fq_step(__fsub_rn(f, a)), -0.5f, 1.0f));
+}
+
+static __device__ __forceinline__ float dsv41_fq_round_fmt(float v, int mbits, float min_normal) {
+    const float p = dsv41_fq_clamp(dsv41_fq_pow2_floor(fabsf(v)), min_normal, INFINITY);
+    const float k = (float) (1 << mbits);
+    const float C = 12582912.0f;                                           // 1.5 * 2^23: round half to even
+    const float y = dsv41_fq_scale(v / p, k, 0.0f);
+    const float r = dsv41_fq_scale(dsv41_fq_scale(y, 1.0f, C), 1.0f, -C);
+    return __fmul_rn(dsv41_fq_scale(r, 1.0f / k, 0.0f), p);
+}
+
+// one thread per element; a block of BS elements = BS consecutive lanes (n % BS == 0, so a lane group is wholly in or
+// wholly out of range and every lane takes part in the shuffles)
+template <int BS>
+static __global__ void dsv41_fake_quant_f32(const float * __restrict__ x, float * __restrict__ y, const int64_t n,
+                                            const int mode, const float maxv, const float floor_) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const float xi = i < n ? x[i] : 0.0f;
+    float a = i < n ? fabsf(xi) : -FLT_MAX;
+#pragma unroll
+    for (int o = BS / 2; o > 0; o >>= 1) {
+        a = fmaxf(a, __shfl_xor_sync(0xffffffff, a, o, BS));
+    }
+    if (i >= n) {
+        return;
+    }
+    const float t = dsv41_fq_clamp(a, floor_, INFINITY) / maxv;
+    const float s = mode == 1 ? dsv41_fq_round_fmt(t, 3, 0x1p-6f) : dsv41_fq_pow2_ceil(t);
+    const float v = dsv41_fq_clamp(xi / s, -maxv, maxv);
+    const float q = mode == 0 ? dsv41_fq_round_fmt(v, 3, 0x1p-6f) : dsv41_fq_round_fmt(v, 1, 1.0f);
+    y[i] = __fmul_rn(q, s);
+}
+
+void ggml_cuda_op_dsv41_fake_quant(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 && ggml_is_contiguous(src0));
+    const int mode = ggml_get_op_params_i32(dst, 0);
+    const int64_t n = ggml_nelements(src0);
+    const float maxv = mode == 0 ? 448.0f : 6.0f;
+    const float floor_ = mode == 0 ? 1e-4f : mode == 1 ? 6.0f / 512.0f : 6.0f * 0x1p-126f;
+    const int64_t blocks = (n + 255) / 256;
+    cudaStream_t stream = ctx.stream();
+    if (mode == 1) {
+        GGML_ASSERT(n % 16 == 0);
+        dsv41_fake_quant_f32<16><<<blocks, 256, 0, stream>>>((const float *) src0->data, (float *) dst->data, n, mode, maxv, floor_);
+    } else {
+        GGML_ASSERT(n % 32 == 0);
+        dsv41_fake_quant_f32<32><<<blocks, 256, 0, stream>>>((const float *) src0->data, (float *) dst->data, n, mode, maxv, floor_);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+
+// ---- Strata-DS4: GGML_OP_DSV41_HC_MIXES - the two HC mixes of one model.py Block.hc_mixes in one kernel.
+// tools/v41/engine/ds41_dense.cpp hc_mixes builds them from mul + add + sigmoid + ggml_scale(_bias); this repeats that
+// composite step for step under the same -use_fast_math flags, so the values are bit-identical:
+// a stock binary op is one plain op (__fmul_rn / __fadd_rn: .rn.ftz, never contracted, = binbcast's a op b), ggml_scale
+// is scale_f32's `scale * x + bias` = one FMA (__fmaf_rn), sigmoid is unary_op_kernel's op_sigmoid.
+static __device__ __forceinline__ float dsv41_hc_mix_sigmoid(float x) {
+    return 1.0f / (1.0f + expf(-x));
+}
+
+// one thread per output element: dst [hc, 2*nt] = [ pre | post ]
+static __global__ void dsv41_hc_mixes_f32(
+        const float * __restrict__ mixes,
+        const int64_t nrow,                                // mixes->ne[0] = 2*hc (+ hc*hc comb rows the op does not read)
+        const float * __restrict__ scale,
+        const float * __restrict__ base,
+        float * __restrict__ dst,
+        const int64_t hc,
+        const int64_t nt,
+        const float eps) {
+    const int64_t n = 2*hc*nt;
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const int64_t h    = i % hc;
+    const int64_t col  = i / hc;                       // 0..nt-1 = the pre mix, nt..2*nt-1 = the post mix
+    const int64_t post = col >= nt;
+    const int64_t t    = post ? col - nt : col;
+    const int64_t r    = post ? hc + h : h;
+    const float   v    = __fadd_rn(__fmul_rn(mixes[r + nrow*t], scale[post]), base[r]);
+    const float   s    = dsv41_hc_mix_sigmoid(v);
+    dst[i] = post ? __fmaf_rn(2.0f, s, 0.0f) : __fmaf_rn(1.0f, s, eps);
+}
+
+void ggml_cuda_op_dsv41_hc_mixes(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * mixes = dst->src[0];
+    const ggml_tensor * scale = dst->src[1];
+    const ggml_tensor * base  = dst->src[2];
+    GGML_ASSERT(mixes->type == GGML_TYPE_F32 && ggml_is_contiguous(mixes));
+    GGML_ASSERT(scale->type == GGML_TYPE_F32 && ggml_nelements(scale) == 2);
+    GGML_ASSERT(base->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->ne[1] % 2 == 0 && mixes->ne[0] >= dst->ne[0] * 2);
+    const int64_t hc = base->ne[0] / 2;
+    const int64_t nt = dst->ne[1] / 2;
+    const float   eps = ggml_get_op_params_f32(dst, 0);
+    const int64_t n = 2*hc*nt;
+    const int64_t blocks = (n + 255) / 256;
+    cudaStream_t stream = ctx.stream();
+    dsv41_hc_mixes_f32<<<blocks, 256, 0, stream>>>((const float *) mixes->data, mixes->ne[0], (const float *) scale->data,
+                                                   (const float *) base->data, (float *) dst->data, hc, nt, eps);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+
+// ---- Strata-DS4: GGML_OP_DSV41_ROUTE_SCORES / _WEIGHTS - model.py Gate in two kernels.  The engine's stock-op
+// composite step for step under the same -use_fast_math flags, so bit-identical: unary.cu op_softplus / op_sqrt, the
+// binbcast ops as single .rn ops (__fadd_rn / __fsub_rn / __fmul_rn, never contracted), get_rows' copy, sum_rows'
+// reduce_rows_f32 (lane j of warp 0 holds value j, every other lane and warp 0, then the xor-shuffle tree: adding the
+// zeros is exact, so one warp's tree is the same sum), scale_f32's `scale * x + bias` and binbcast's op_div `a / b`.
+static __global__ void dsv41_route_scores_f32(
+        const float * __restrict__ x, const float * __restrict__ bt, const float * __restrict__ rb,
+        const float * __restrict__ bv, const float * __restrict__ m, float * __restrict__ dst,
+        const int64_t ne, const int64_t nt) {
+    const int64_t n = ne*nt;
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+    const int64_t e = i % ne;
+    const int64_t t = i / ne;
+    const float v  = x[i];
+    const float sp = (v > 20.0f) ? v : log1pf(expf(v));
+    const float s  = sqrtf(sp);
+    float b = bt[e];
+    if (bv) {
+        b = __fadd_rn(__fmul_rn(__fsub_rn(bv[e], bt[e]), m[t]), bt[e]);
+    }
+    dst[i]     = s;
+    dst[n + i] = __fadd_rn(__fadd_rn(s, b), rb[e]);
+}
+
+void ggml_cuda_op_dsv41_route_scores(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * logits  = dst->src[0];
+    const ggml_tensor * bias_vl = dst->src[3];
+    const ggml_tensor * img     = dst->src[4];
+    const int64_t ne = logits->ne[0];
+    const int64_t nt = dst->ne[1];
+    const int64_t blocks = (ne*nt + 255) / 256;
+    dsv41_route_scores_f32<<<blocks, 256, 0, ctx.stream()>>>(
+        (const float *) logits->data, (const float *) dst->src[1]->data, (const float *) dst->src[2]->data,
+        bias_vl ? (const float *) bias_vl->data : nullptr, img ? (const float *) img->data : nullptr,
+        (float *) dst->data, ne, nt);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// one warp per token, lane j < k = the token's j-th pick
+static __global__ void dsv41_route_weights_f32(
+        const char * __restrict__ scores, const int64_t nb1, const char * __restrict__ ids, const int64_t inb1,
+        float * __restrict__ dst,
+        const int k, const int64_t nt, const int norm, const float scale, const float one, const float tiny,
+        const float zero) {
+    const int64_t t = (int64_t) blockIdx.x * (blockDim.x / WARP_SIZE) + threadIdx.x / WARP_SIZE;
+    const int lane = threadIdx.x % WARP_SIZE;
+    if (t >= nt) {
+        return;
+    }
+    const float * sc = (const float *) (scores + t*nb1);
+    float w = lane < k ? sc[((const int32_t *) (ids + t*inb1))[lane]] : 0.0f;
+    if (norm) {
+        const float s = warp_reduce_sum(w);
+        const float d = one * s + tiny;
+        w = w / d;
+    }
+    if (lane < k) {
+        dst[t*k + lane] = scale * w + zero;
+    }
+}
+
+void ggml_cuda_op_dsv41_route_weights(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * scores = dst->src[0];
+    const ggml_tensor * ids    = dst->src[1];
+    const int     k  = (int) dst->ne[0];
+    const int64_t nt = dst->ne[1];
+    const int   norm  = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int warps = 4;
+    const int64_t blocks = (nt + warps - 1) / warps;
+    // 1, 1e-20 and 0 as kernel arguments: ggml_scale_bias / ggml_scale pass theirs at run time, so the compiler must not
+    // fold `1 * s + 1e-20` or `scale * w + 0` into a different instruction than scale_f32's
+    dsv41_route_weights_f32<<<blocks, warps * WARP_SIZE, 0, ctx.stream()>>>(
+        (const char *) scores->data, (int64_t) scores->nb[1], (const char *) ids->data, (int64_t) ids->nb[1], (float *) dst->data, k, nt,
+        norm, scale, 1.0f, 1e-20f, 0.0f);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// ---- Strata-DS4: GGML_OP_DSV41_COPIES - up to 5 same-type 4-byte copies in one launch (blockIdx.y = the pair)
+struct dsv41_copy_pair {
+    const char * s;
+    char *       d;
+    int64_t      n;
+    int64_t      sne[4], snb[4], dne[4], dnb[4];
+};
+struct dsv41_copy_args {
+    dsv41_copy_pair p[5];
+};
+
+static __global__ void dsv41_copies_k(const dsv41_copy_args a) {
+    const dsv41_copy_pair & q = a.p[blockIdx.y];
+    for (int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; i < q.n; i += (int64_t) gridDim.x * blockDim.x) {
+        int64_t r = i, so = 0, dof = 0;
+#pragma unroll
+        for (int k = 0; k < 3; ++k) {
+            so += (r % q.sne[k]) * q.snb[k];
+            r /= q.sne[k];
+        }
+        so += r * q.snb[3];
+        r = i;
+#pragma unroll
+        for (int k = 0; k < 3; ++k) {
+            dof += (r % q.dne[k]) * q.dnb[k];
+            r /= q.dne[k];
+        }
+        dof += r * q.dnb[3];
+        *(uint32_t *) (q.d + dof) = *(const uint32_t *) (q.s + so);
+    }
+}
+
+void ggml_cuda_op_dsv41_copies(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int n = ggml_get_op_params_i32(dst, 0);
+    dsv41_copy_args a = {};
+    int64_t nmax = 0;
+    for (int p = 0; p < n; ++p) {
+        const ggml_tensor * s = dst->src[2*p + 0];
+        const ggml_tensor * d = dst->src[2*p + 1];
+        a.p[p].s = (const char *) s->data;
+        a.p[p].d = (char *) d->data;
+        a.p[p].n = ggml_nelements(s);
+        for (int k = 0; k < 4; ++k) {
+            a.p[p].sne[k] = s->ne[k]; a.p[p].snb[k] = (int64_t) s->nb[k];
+            a.p[p].dne[k] = d->ne[k]; a.p[p].dnb[k] = (int64_t) d->nb[k];
+        }
+        nmax = std::max(nmax, a.p[p].n);
+    }
+    const int64_t blocks = std::min<int64_t>((nmax + 255) / 256, 65535);
+    dsv41_copies_k<<<dim3((unsigned) blocks, (unsigned) n), 256, 0, ctx.stream()>>>(a);
+    CUDA_CHECK(cudaGetLastError());
+}
