+// [20480, 24], 80 calls a token: mul_mat_vec_f gives each row ONE 256-thread block, so 24 SMs read the 1.9 MB (~14 us a
+// call).  Here each warp of that block is a 32-thread block of its own, the row's nwarps blocks one cluster: every lane
+// takes the same columns in the same order (the same FMAs), the same first warp_reduce_sum, and cluster rank 0 does the
+// block's second warp_reduce_sum on the same values (lane w = warp w's sum, the other lanes 0) - the same bits.
+#include <cooperative_groups.h>
+template <int nwarps>
+static __global__ void __launch_bounds__(32) mul_mat_vec_f_split(
+        const float * x_ptr, const float * y_ptr, float * dst, const int ncols2, const int stride_row) {
+#if __CUDA_ARCH__ >= GGML_CUDA_CC_HOPPER
+    const cooperative_groups::cluster_group cluster = cooperative_groups::this_cluster();
+    __shared__ float wsum;
+    const int w    = (int) cluster.block_rank();
+    const int row  = blockIdx.x / nwarps;
+    const int lane = threadIdx.x;
+
+    ggml_cuda_pdl_sync();
+    const float2 * x2 = (const float2 *) (x_ptr + int64_t(row)*stride_row);
+    const float2 * y2 = (const float2 *) y_ptr;
+    float sumf = 0.0f;
