diff --git a/ggml/src/ggml-cuda/mmid-back.cu b/ggml/src/ggml-cuda/mmid-back.cu
new file mode 100644
index 000000000..a16a13f4d
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmid-back.cu
@@ -0,0 +1,152 @@
+#include "mmid-back.cuh"
+#include "convert.cuh"
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+// Xolotl (LoRA training): dst = ggml_mul_mat_id_back(as, g, ids):
+//   dst[:, e % ne11, t] += as[ids[e, t]]^T g[:, e, t]      as [K, M, E] (frozen, any type with a CUDA to-F32),
+//                                                         g [M, n_used, T] F32, ids [n_used, T] I32, dst [K, ne11, T]
+// The routing is read on the host (one stream sync, so the node disables CUDA graphs). Then per expert that has
+// routed columns: dequantize its [K, M] slice to F32, gather its gradient columns, one GEMM, scatter-add the
+// result columns into dst. Within one expert every (e, t) pair is a distinct dst column when ne11 == n_used, and
+// when b was broadcast (ne11 == 1) a token picks an expert at most once, so the scatter needs no atomics; experts
+// run one after another on the stream.
+
+static __global__ void k_mmid_back_gather(const char * __restrict__ g, float * __restrict__ out,
+                                          const int32_t * __restrict__ ge, const int32_t * __restrict__ gt,
+                                          const int64_t M, const size_t nb1, const size_t nb2, const int n) {
+    for (int j = blockIdx.y; j < n; j += gridDim.y) {
+        const float * src = (const float *) (g + (size_t) ge[j] * nb1 + (size_t) gt[j] * nb2);
+        for (int64_t m = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; m < M; m += (int64_t) gridDim.x * blockDim.x) {
+            out[(size_t) j * M + m] = src[m];
+        }
+    }
+}
+
+static __global__ void k_mmid_back_scatter_add(const float * __restrict__ in, char * __restrict__ dst,
+                                               const int32_t * __restrict__ de, const int32_t * __restrict__ dt,
+                                               const int64_t K, const size_t nb1, const size_t nb2, const int n) {
+    for (int j = blockIdx.y; j < n; j += gridDim.y) {
+        float * d = (float *) (dst + (size_t) de[j] * nb1 + (size_t) dt[j] * nb2);
+        for (int64_t k = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; k < K; k += (int64_t) gridDim.x * blockDim.x) {
+            d[k] += in[(size_t) j * K + k];
+        }
+    }
+}
+
+bool ggml_cuda_mul_mat_id_back_supported(const ggml_tensor * op) {
+    const ggml_tensor * as = op->src[0];
+    return op->type == GGML_TYPE_F32 && op->src[1]->type == GGML_TYPE_F32 && op->src[2]->type == GGML_TYPE_I32 &&
+           op->src[1]->nb[0] == sizeof(float) && ggml_is_contiguous(op) &&
+           ggml_is_contiguous(as) && (as->type == GGML_TYPE_F32 || ggml_get_to_fp32_cuda(as->type) != nullptr);
+}
+
+void ggml_cuda_mul_mat_id_back(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * as  = dst->src[0];
+    const ggml_tensor * g   = dst->src[1];
+    const ggml_tensor * ids = dst->src[2];
+
+    GGML_ASSERT(ggml_cuda_mul_mat_id_back_supported(dst));
+
+    const int64_t K = as->ne[0], M = as->ne[1], E = as->ne[2];
+    const int64_t n_used = ids->ne[0], T = ids->ne[1], ne11 = dst->ne[1];
+    GGML_ASSERT(g->ne[0] == M && g->ne[1] == n_used && g->ne[2] == T);
+    GGML_ASSERT(dst->ne[0] == K && dst->ne[2] == T && n_used % ne11 == 0);
+
+    cudaStream_t stream = ctx.stream();
+
+    CUDA_CHECK(cudaMemsetAsync(dst->data, 0, ggml_nbytes(dst), stream));
+    if (T == 0 || n_used == 0) {
+        return;
+    }
+
+    // routing to the host
+    std::vector<char> ids_h(ggml_nbytes(ids));
+    CUDA_CHECK(cudaMemcpyAsync(ids_h.data(), ids->data, ids_h.size(), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+
+    // bucket the (e, t) pairs by expert: columns of g to read, columns of dst to add to
+    std::vector<int64_t> cnt(E + 1, 0);
+    auto expert_of = [&](int64_t e, int64_t t) -> int32_t {
+        return *(const int32_t *) (ids_h.data() + e * ids->nb[0] + t * ids->nb[1]);
+    };
+    for (int64_t t = 0; t < T; ++t) {
+        for (int64_t e = 0; e < n_used; ++e) {
+            const int32_t x = expert_of(e, t);
+            if (x >= 0 && x < E) {
+                cnt[x + 1]++;
+            }
+        }
+    }
+    for (int64_t x = 0; x < E; ++x) {
+        cnt[x + 1] += cnt[x];
+    }
+    const int64_t npairs = cnt[E];
+    if (npairs == 0) {
+        return;
+    }
+    std::vector<int32_t> idx(4 * npairs);   // [ge | gt | de | dt]
+    {
+        std::vector<int64_t> pos(cnt.begin(), cnt.end() - 1);
+        for (int64_t t = 0; t < T; ++t) {
+            for (int64_t e = 0; e < n_used; ++e) {
+                const int32_t x = expert_of(e, t);
+                if (x < 0 || x >= E) {
+                    continue;
+                }
+                const int64_t p = pos[x]++;
+                idx[0 * npairs + p] = (int32_t) e;
+                idx[1 * npairs + p] = (int32_t) t;
+                idx[2 * npairs + p] = (int32_t) (e % ne11);
+                idx[3 * npairs + p] = (int32_t) t;
+            }
+        }
+    }
+    int64_t maxn = 0;
+    for (int64_t x = 0; x < E; ++x) {
+        maxn = std::max(maxn, cnt[x + 1] - cnt[x]);
+    }
+
+    ggml_cuda_pool_alloc<int32_t> idx_d(ctx.pool(), idx.size());
+    CUDA_CHECK(cudaMemcpyAsync(idx_d.get(), idx.data(), idx.size() * sizeof(int32_t), cudaMemcpyHostToDevice, stream));
+    const int32_t * ge = idx_d.get() + 0 * npairs;
+    const int32_t * gt = idx_d.get() + 1 * npairs;
+    const int32_t * de = idx_d.get() + 2 * npairs;
+    const int32_t * dt = idx_d.get() + 3 * npairs;
+
+    const bool f32 = as->type == GGML_TYPE_F32;
+    const to_fp32_cuda_t to_f32 = f32 ? nullptr : ggml_get_to_fp32_cuda(as->type);
+    ggml_cuda_pool_alloc<float> wbuf(ctx.pool(), f32 ? 1 : (size_t) (K * M));
+    ggml_cuda_pool_alloc<float> gbuf(ctx.pool(), (size_t) (M * maxn));
+    ggml_cuda_pool_alloc<float> obuf(ctx.pool(), (size_t) (K * maxn));
+
+    cublasHandle_t handle = ctx.cublas_handle();
+    CUBLAS_CHECK(cublasSetStream(handle, stream));
+    const float alpha = 1.0f, beta = 0.0f;
+
+    for (int64_t x = 0; x < E; ++x) {
+        const int64_t p0 = cnt[x], n = cnt[x + 1] - cnt[x];
+        if (n == 0) {
+            continue;
+        }
+        const float * W;
+        if (f32) {
+            W = (const float *) ((const char *) as->data + x * as->nb[2]);
+        } else {
+            to_f32((const char *) as->data + x * as->nb[2], wbuf.get(), K * M, stream);
+            W = wbuf.get();
+        }
+        const int ny = (int) std::min<int64_t>(n, 65535);
+        k_mmid_back_gather<<<dim3((unsigned) std::min<int64_t>((M + 255) / 256, 64), ny), 256, 0, stream>>>(
+            (const char *) g->data, gbuf.get(), ge + p0, gt + p0, M, g->nb[1], g->nb[2], (int) n);
+        CUDA_CHECK(cudaGetLastError());
+        // W is row-major [M rows of K] = column-major K x M (ld K): obuf[K, n] = W gbuf[M, n]
+        CUBLAS_CHECK(cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_N, (int) K, (int) n, (int) M,
+                                 &alpha, W, (int) K, gbuf.get(), (int) M, &beta, obuf.get(), (int) K));
+        k_mmid_back_scatter_add<<<dim3((unsigned) std::min<int64_t>((K + 255) / 256, 64), ny), 256, 0, stream>>>(
+            obuf.get(), (char *) dst->data, de + p0, dt + p0, K, dst->nb[1], dst->nb[2], (int) n);
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
