+#undef TOPK_NPL
+    GGML_ABORT("fatal error");
+}
+
+static bool argsort_use_rank(const int ncols) {
+    static const bool on = [] {
+        const char * v = getenv("GGML_CUDA_RANK_ARGSORT");
