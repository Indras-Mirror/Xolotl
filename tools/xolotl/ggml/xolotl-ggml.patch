+            const int t = e - 3 + (k == 0 ? 0 : k == 1 ? 1 : k == 2 ? -1 : 2);
+            const float s = ldexpf(1.0f, t);
+            bool ok = true;
+            for (int j = 0; j < QK_MXFP4 && ok; ++j) ok = ds41_e2m1_exact(x[j], s) >= 0;
+            if (ok) { E = t; found = true; }
+        }
+        if (!found) { int e2; frexpf(amax / 6.0f, &e2); E = e2; }   // pow2 ceil of amax / 6 (approximate path)
+    }
+    E = max(-126, min(127, E));
+    y->e = (uint8_t) (E + 127);
+    const float s = ldexpf(1.0f, E);
+    for (int j = 0; j < QK_MXFP4/2; ++j) {
+        int c0 = ds41_e2m1_exact(x[j], s), c1 = ds41_e2m1_exact(x[j + QK_MXFP4/2], s);
+        if (c0 < 0) c0 = ds41_e2m1_nearest(x[j] / s) | (x[j] < 0.0f ? 8 : 0);
+        if (c1 < 0) c1 = ds41_e2m1_nearest(x[j + QK_MXFP4/2] / s) | (x[j + QK_MXFP4/2] < 0.0f ? 8 : 0);
+        y->qs[j] = (uint8_t) (c0 | (c1 << 4));
+    }
