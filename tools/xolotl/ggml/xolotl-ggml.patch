+struct ggml_tensor * ggml_dsv41_stream(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        int                   mode,
+        int                   k,
+        struct ggml_tensor ** keep,
+        int                   n) {
+    GGML_ASSERT(mode >= 0 && mode <= 2 && k >= 1 && n >= 0 && n < GGML_MAX_SRC);
+    struct ggml_tensor * result = ggml_view_tensor(ctx, a);
+    const int32_t params[2] = { mode, k };
+    ggml_set_op_params(result, params, sizeof(params));
+    result->op     = GGML_OP_DSV41_STREAM;
+    result->src[0] = a;
+    for (int i = 0; i < n; ++i) {
+        result->src[1 + i] = keep[i];
+    }
+    return result;
+}
