+// Strata-DS4 (ggml_dsv41_route): a DeepSeek-V4 router with the stock chain's values bit for bit.  One block per
+// row: each thread scores one column - s = sqrt(softplus(x)) as unary.cu's op_softplus / op_sqrt, the selection key
+// of (s + b0) + b1 as k_argsort_topk_warp_f32_i32's - then warp 0 takes the first k (value desc, equal values by
+// ascending column), sums the weights s[ids] as sum_rows does (warp_reduce_sum, weight j in lane j) and writes
+// w / (1 * sum + 1e-20) as ggml_div and scale * w + 0 as scale_f32.  Replaces softplus, sqrt, 2 adds, the top-k,
+// get_rows, sum_rows, scale_bias, div and scale.  bvl / msk (ggml_dsv41_route_vl): b0 becomes ((bvl - b0) * msk[row]) +
+// b0, the vision router's sub / mul / add (msk is 0 or 1, so the product is exact and the bits match).
+static __device__ __forceinline__ unsigned long long dsv41_route_warp_min(unsigned long long v) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= GGML_CUDA_CC_AMPERE
+    const unsigned hi = __reduce_min_sync(0xFFFFFFFFu, (unsigned) (v >> 32));
+    const unsigned lo = __reduce_min_sync(0xFFFFFFFFu, (unsigned) (v >> 32) == hi ? (unsigned) v : 0xFFFFFFFFu);
+    return ((unsigned long long) hi << 32) | lo;
+#else
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        const unsigned long long o = __shfl_xor_sync(0xFFFFFFFFu, v, off);
+        v = o < v ? o : v;
+    }
+    return v;
+#endif
+}
+
+template<int NPL>   // NPL: columns per lane in the selection, >= ceil(ncols / 32)
+static __global__ void k_dsv41_route(const float * x, const float * b0, const float * bvl, const float * msk,
+                                     const float * b1, int * ids, float * wts,
+                                     const int ncols, const int k, const int64_t sx, const int64_t sids,
+                                     const int64_t swts, const int norm, const float scale) {
+    ggml_cuda_pdl_lc();
+    __shared__ unsigned s_key[32 * NPL];
+    __shared__ float    s_val[32 * NPL];
+    const int64_t row = blockIdx.x;
+    const int c = threadIdx.x;
+    float bias0 = 0.0f, bias1 = 0.0f;
+    if (c < ncols) {
+        bias0 = b0[c];
+        if (bvl) {
+            bias0 = __fadd_rn(__fmul_rn(__fsub_rn(bvl[c], bias0), msk[row]), bias0);
+        }
+        bias1 = b1[c];
+    }
+    ggml_cuda_pdl_sync();
+    if (c < ncols) {
+        const float xv = x[row * sx + c];
+        const float sp = (xv > 20.0f) ? xv : logf(1.0f + expf(xv));
+        const float s  = sqrtf(sp);
+        const float v  = (s + bias0) + bias1;
+        const unsigned u = __float_as_uint(v);
+        s_key[c] = ~((u & 0x80000000u) ? ~u : (u | 0x80000000u));   // descending
+        s_val[c] = s;
+    }
+    __syncthreads();
+    if (threadIdx.x >= 32) {
+        return;
+    }
+    const int lane = threadIdx.x;
+    unsigned long long key[NPL];
+    unsigned long long best = ~0ull;
+#pragma unroll
+    for (int i = 0; i < NPL; ++i) {
+        const int cc = lane + 32 * i;
+        key[i] = cc < ncols ? (((unsigned long long) s_key[cc] << 32) | (unsigned) cc) : ~0ull;   // padding: last
+        best = key[i] < best ? key[i] : best;
+    }
+    int * ids_row = ids + row * sids;
+    float w = 0.0f;   // lane j: the j-th pick's s
+    for (int j = 0; j < k; ++j) {
+        const unsigned long long m = dsv41_route_warp_min(best);
+        const int col = (int) (m & 0xFFFFFFFFull);
+        if (lane == j) {
+            w = s_val[col];
+        }
+        if (lane == 0) {
+            ids_row[j] = col;
+        }
+        if (lane == (col & 31)) {   // the winner drops that column and rescans its own
+            best = ~0ull;
+#pragma unroll
+            for (int i = 0; i < NPL; ++i) {
+                if (i == (col >> 5)) {
+                    key[i] = ~0ull;
+                }
+                best = key[i] < best ? key[i] : best;
+            }
+        }
+    }
+    if (wts == nullptr) {
+        return;
+    }
+    float q = w;
+    if (norm) {
+        const float sum = warp_reduce_sum(w);
+        q = w / (1.0f * sum + 1e-20f);
+    }
+    if (lane < k) {
+        wts[row * swts + lane] = scale * q + 0.0f;
+    }
+}
