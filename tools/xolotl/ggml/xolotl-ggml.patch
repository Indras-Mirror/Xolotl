+// Strata DS4.1 --kv-fp4: MXFP4 K rows (the lightning indexer's keys).  E8M0(e) x e2m1 - exact values.
+template <typename T, int ne>
+static __device__ __forceinline__ void dequantize_V_mxfp4(const void * __restrict__ vx, void * __restrict__ dst, const int64_t i0) {
+    const block_mxfp4 * x = (const block_mxfp4 *) vx;
+    const int64_t ib  = i0 / QK_MXFP4;
+    const int     iqs = i0 % QK_MXFP4;
+    const float d = ggml_cuda_e8m0_to_fp32(x[ib].e) * 0.5f;
+#pragma unroll
+    for (int l = 0; l < ne; ++l) {
+        const int k = iqs + l;
+        const uint8_t q = x[ib].qs[k % (QK_MXFP4/2)];
+        const float v = d * kvalues_mxfp4[k < QK_MXFP4/2 ? (q & 0x0F) : (q >> 4)];
+        if constexpr (std::is_same<T, float>::value) {
+            ((float *) dst)[l] = v;
+        } else if constexpr (std::is_same<T, half>::value) {
+            ((half *) dst)[l] = __float2half(v);
+        } else {
+            static_assert(std::is_same_v<T, void>, "unsupported type");
+        }
+    }
+}
