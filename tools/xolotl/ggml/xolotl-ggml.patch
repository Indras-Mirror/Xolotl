+struct ggml_tensor * ggml_dsv41_kv_gather(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * ia,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * ib,
+        int                   pad) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32 || a->type == GGML_TYPE_F16);
+    GGML_ASSERT(b->type == GGML_TYPE_NVFP4 || b->type == GGML_TYPE_F16 || b->type == GGML_TYPE_F32);
+    GGML_ASSERT(ia->type == GGML_TYPE_I32 && ib->type == GGML_TYPE_I32 && ggml_is_contiguous(ia) && ggml_is_contiguous(ib));
+    GGML_ASSERT(a->ne[0] == b->ne[0] && ia->ne[1] == ib->ne[1] && ia->ne[2] == 1 && ib->ne[2] == 1 && pad >= 0);
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, a->ne[0], ia->ne[0] + ib->ne[0] + pad, ia->ne[1]);
+    ggml_set_op_params_i32(result, 0, pad);
+    result->op     = GGML_OP_DSV41_KV_GATHER;
+    result->src[0] = a;
+    result->src[1] = ia;
+    result->src[2] = b;
+    result->src[3] = ib;
+    return result;
+}
