From 622e494b0ef30d7faa7b7b8ef7ff413e62bd28dc Mon Sep 17 00:00:00 2001
From: Excidos <malichcoory@gmail.com>
Date: Sat, 21 Nov 2026 07:50:16 +1100
Subject: [PATCH] inkling2-loop: attach NVFP4 per-expert scales to the physical
 layers before the loop slots copy them (passes 2-3 ran unscaled)

---
 src/models/inkling2-loop.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/models/inkling2-loop.cpp b/src/models/inkling2-loop.cpp
index 0de66bae..4a76c367 100644
--- a/src/models/inkling2-loop.cpp
+++ b/src/models/inkling2-loop.cpp
@@ -61,6 +61,19 @@ void llama_model_inkling2_loop::load_arch_tensors(llama_model_loader & ml) {
         }
     }
 
+    // per-expert scales of NVFP4-kept experts (`blk.N.ffn_*_exps.scale`): attach them to the physical layers BEFORE the
+    // slots copy them - llama_model_base::load_tensors() adds scales only after load_arch_tensors(), by slot index, and
+    // there is no `blk.24.*.scale` (Xolotl, 21 Nov: without this passes 2-3 ran their experts unscaled)
+    for (int il = 0; il < n_phys; ++il) {
+        auto & layer = layers[il];
+        if (layer.ffn_gate_up_exps && !layer.ffn_up_exps_s) {
+            layer.ffn_up_exps_s = create_tensor(tn(LLM_TENSOR_FFN_GATE_UP_EXPS, "scale", il), {hparams.n_expert}, TENSOR_NOT_REQUIRED);
+        }
+        if (layer.ffn_down_exps && !layer.ffn_down_exps_s) {
+            layer.ffn_down_exps_s = create_tensor(tn(LLM_TENSOR_FFN_DOWN_EXPS, "scale", il), {hparams.n_expert}, TENSOR_NOT_REQUIRED);
+        }
+    }
+
     // share the physical weights, each cache slot keeps its own KV and conv state
     for (int il = n_phys; il < (int) hparams.n_layer(); ++il) {
         layers[il] = layers[layer_phys(il)];
-- 
