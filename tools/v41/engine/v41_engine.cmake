        set(_v41_ggml_src ${STRATA_GGML_DIR}/ggml/src)
    else()
        set(_v41_ggml_src ${CMAKE_CURRENT_SOURCE_DIR}/third_party/llama.cpp/ggml/src)
    endif()
    add_library(ds41_dense STATIC ${_v41_dir}/ds41_dense.cpp ${_v41_dir}/ds41_engram.cpp)
    target_include_directories(ds41_dense PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include ${_v41_dir} PRIVATE ${_v41_ggml_src})
    target_link_libraries(ds41_dense PUBLIC ggml ggml-cpu ggml-base)
    if(TARGET ggml-cuda)
        target_link_libraries(ds41_dense PUBLIC ggml-cuda)
        target_compile_definitions(ds41_dense PRIVATE DS41_HAVE_CUDA)
    endif()
    # opt-in: the activation rounding as ONE ggml op (GGML_OP_DSV41_FAKE_QUANT) instead of ds41_ops.hpp's stock-op
    # composite.  Needs the llama.cpp tree patched with tools/v41/ggml/dsv41-fake-quant.patch (the tree is not tracked
    # here, so the stock build never depends on it).  Bit-identical (test_ds41_fq); decode 26.3 -> 27.7 tok/s.
    option(STRATA_DSV41_FQ_OP "DeepSeek-V4.1: fused activation rounding op (needs tools/v41/ggml/dsv41-fake-quant.patch)" OFF)
    if(STRATA_DSV41_FQ_OP)
        file(READ ${_v41_ggml_src}/../include/ggml.h _v41_ggml_h)
        if(NOT _v41_ggml_h MATCHES "GGML_OP_DSV41_FAKE_QUANT")
            message(FATAL_ERROR "STRATA_DSV41_FQ_OP: ${_v41_ggml_src}/.. is not patched - run: patch -p1 -d <llama.cpp> "
                                "< ${CMAKE_CURRENT_SOURCE_DIR}/tools/v41/ggml/dsv41-fake-quant.patch")
        endif()
        target_compile_definitions(ds41_dense PRIVATE STRATA_DSV41_FQ_OP)
    endif()
    # opt-in: the two HC mixes of one Block.hc_mixes (mul, add, sigmoid, scale) as ONE ggml op
    # (GGML_OP_DSV41_HC_MIXES) instead of the stock-op composite.  Needs the llama.cpp tree patched with
    # tools/v41/ggml/dsv41-fuse.patch (the tree is not tracked here).  Bit-identical (test_ds41_hcmix).
    option(STRATA_DSV41_HC_MIX "DeepSeek-V4.1: fused HC mix op (needs tools/v41/ggml/dsv41-fuse.patch)" OFF)
    if(STRATA_DSV41_HC_MIX)
        file(READ ${_v41_ggml_src}/../include/ggml.h _v41_ggml_h_mix)
        if(NOT _v41_ggml_h_mix MATCHES "GGML_OP_DSV41_HC_MIXES")
            message(FATAL_ERROR "STRATA_DSV41_HC_MIX: ${_v41_ggml_src}/.. is not patched - run: patch -p1 -d <llama.cpp> "
                                "< ${CMAKE_CURRENT_SOURCE_DIR}/tools/v41/ggml/dsv41-fuse.patch")
        endif()
        target_compile_definitions(ds41_dense PRIVATE STRATA_DSV41_HC_MIX)
    endif()
endif()
